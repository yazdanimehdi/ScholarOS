---
import ClassicBlog from '../../themes/classic/Blog.astro';
import EditorialBlog from '../../themes/editorial/Blog.astro';
import { loadBlog } from '../../themes/editorial/data';
import { getEntries, getPublicFeeds } from '../../lib/content';
import { getTheme, isPersonalMode } from '../../lib/config';

const personal = isPersonalMode();

const posts = (await getEntries('posts')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const feeds = (await getPublicFeeds()).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

// Combine into a unified timeline
type TimelineItem = {
  type: 'post' | 'feed';
  date: Date;
  data: (typeof posts)[0] | (typeof feeds)[0];
};

const timeline: TimelineItem[] = [
  ...posts.map((p) => ({ type: 'post' as const, date: p.data.date, data: p })),
  ...feeds.map((f) => ({ type: 'feed' as const, date: new Date(f.data.date), data: f })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
const editorialBlog = getTheme() === 'editorial' ? await loadBlog() : null;
---

{editorialBlog ? <EditorialBlog {...editorialBlog} /> : <ClassicBlog {personal} {posts} {feeds} {timeline} />}
