---
import ClassicPost from '../../themes/classic/Post.astro';
import EditorialPost from '../../themes/editorial/Post.astro';
import { loadPost } from '../../themes/editorial/data';
import { getTheme } from '../../lib/config';
import { getEntries, staticProps } from '../../lib/content';
import { resolveImage } from '../../lib/content/image';

export async function getStaticPaths() {
  const posts = await getEntries('posts');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const props = await staticProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { post } = props;

let ogImage: string | undefined;
if (post.data.coverImage) {
  const resolved = await resolveImage(post.data.coverImage, 1200);
  ogImage = resolved.src;
}
const editorialPost = getTheme() === 'editorial' ? await loadPost(post) : null;
---

{editorialPost ? <EditorialPost {...editorialPost} {ogImage} /> : <ClassicPost {post} {ogImage} />}
