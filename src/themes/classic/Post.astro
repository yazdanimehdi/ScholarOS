---
import MarkdownLayout from '../../layouts/MarkdownLayout.astro';
import SEO from '../../components/astro/SEO.astro';
import type { CollectionEntry } from 'astro:content';
import EntryBody from '../../components/astro/EntryBody.astro';
import { entryHeadings } from '../../lib/content';

interface Props {
  post: CollectionEntry<'posts'>;
  ogImage?: string;
}

const { post, ogImage } = Astro.props;
const headings = await entryHeadings(post);
---

<MarkdownLayout
  title={post.data.title}
  description={post.data.excerpt}
  ogImage={ogImage}
  date={post.data.date}
  author={post.data.author}
  tags={post.data.tags}
  keywords={post.data.keywords}
  headings={headings}
>
  <SEO
    type="blogPost"
    title={post.data.title}
    description={post.data.excerpt}
    datePublished={post.data.date}
    author={post.data.author}
    keywords={post.data.keywords}
  />
  <EntryBody entry={post} />
</MarkdownLayout>
